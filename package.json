{
  "name": "cdk-geospatial-dynamodb-vectors",
  "version": "1.0.0",
  "description": "Demo project: 4D (x, y, z, time) geospatial proximity search using a DynamoDB vector index",
  "license": "MIT",
  "private": true,
  "bin": {
    "cdk-geospatial-dynamodb-vectors": "bin/app.ts"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0",
    "npm": ">=11.17.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all",
    "destroy": "cdk destroy --all",
    "load-data": "tsx scripts/load-flights.ts",
    "local-api": "tsx scripts/local-api.ts",
    "evaluate": "tsx scripts/evaluate-recall.ts",
    "frontend": "npm run dev --prefix frontend"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@aws-sdk/client-dynamodb": "^3.1165.0",
    "@aws-sdk/lib-dynamodb": "^3.1165.0",
    "aws-cdk-lib": "2.275.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@types/aws-lambda": "^8.10.164",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.6",
    "@typescript-eslint/parser": "^8.72.2",
    "aws-cdk": "2.1148.0",
    "aws-sdk-client-mock": "^4.1.0",
    "cdk-nag": "^3.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "^0.19.1"
    }
  }
}
